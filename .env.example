# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets to this file.

# Set "DEBUG=False" for production
DEBUG=True

# Get a secure secret key from https://djecrety.ir
SECRET_KEY=django-insecure-change-me

# Don't use "*" for ALLOWED_HOSTS in production
ALLOWED_HOSTS=www.example.com,example.com

CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Asia/Kolkata

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Single connection string (takes precedence over the DB_* fields below).
# Supported schemes: postgresql://, postgis://, mysql://, mysqlgis://,
# mysql-connector://, sqlite://, spatialite://, oracle://, mssql://,
# pyodbc://, redshift://, ldap://
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ----OR----

DB_INIT_PASSWORD=change-me-to-a-random-value
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dbname
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# ----------------------------------------------------------------------------
# SMTP / Outgoing email
# ----------------------------------------------------------------------------
# Used for: password reset, welcome/onboarding emails, leave approval
# notifications, attendance notifications, ticket notifications, payroll
# notifications, and HR announcements.
#
# If left unset, the app keeps running and simply logs email send failures
# instead of crashing (see base/backends.py).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Your Company HR <no-reply@example.com>
SMTP_USE_TLS=True

# ----------------------------------------------------------------------------
# GCP Storage for Media Configuration (optional)
# ----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS="pathToYourServiceAccountJsonFile"
# GS_BUCKET_NAME="yourGCPBucketName"
# DEFAULT_FILE_STORAGE="horilla.horilla_backends_gcp.PrivateMediaStorage"
# MEDIA_URL="https://storage.cloud.google.com/yourGCPBucketName/media"
# MEDIA_ROOT="https://storage.cloud.google.com/yourGCPBucketName/media"
# NAMESPACE="private"
